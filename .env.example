# Conexión directa a PostgreSQL para el worker (rol de servidor). NUNCA se usa en el navegador.
# En Supabase: Project Settings → Database → Connection string (modo "Session").
DATABASE_URL=postgresql://postgres:CONTRASEÑA@HOST:5432/postgres

# Contacto del proyecto que se envía en el User-Agent a los servicios públicos (email o URL del proyecto).
CONTACT=https://github.com/thedesignerux-lgtm/market-intelligence-

# Opcionales
# CACHE_DIR=.cache
# OSM_EXTRACT_BASE_URL=https://download.openstreetmap.fr/extracts/europe/spain/galicia
# OSM_EXTRACT_MAX_AGE_HOURS=24
# GEOCODER_MIN_INTERVAL_MS=250
# WORKER_ID=worker-1

# --- Aplicación web (claves públicas de Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
