# Importador (worker) de Market Intelligence.
# Necesita osmium-tool para procesar los extractos de OpenStreetMap.
FROM node:22-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends osmium-tool ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
COPY worker ./worker
ENV NODE_ENV=production CACHE_DIR=/app/.cache
# Usuario sin privilegios
RUN useradd --create-home worker && mkdir -p /app/.cache && chown -R worker /app/.cache
USER worker
CMD ["npx", "tsx", "worker/index.ts"]
